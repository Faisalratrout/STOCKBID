# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://stockbid:stockbid_dev_password@localhost:5432/stockbid?schema=public

# --- Redis (BullMQ auction-close queue) ---
REDIS_URL=redis://localhost:6379

# --- Auth: generate each with `openssl rand -hex 32` (must differ, 32+ chars) ---
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-access
JWT_REFRESH_SECRET=replace-me-with-a-long-random-string-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Cloudinary (PLACEHOLDERS: real values must come from the project owner) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Mailer (stubbed in dev: tokens are logged to the console) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=STOCKBID <no-reply@stockbid.example>
APP_URL=http://localhost:3000

# --- Seed (used by `npm run seed` to create the first admin) ---
SEED_ADMIN_EMAIL=admin@stockbid.example
SEED_ADMIN_PASSWORD=change-me-before-seeding
